<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Court 822 | Team Check-in</title>
<style>body{font:16px system-ui,sans-serif;background:#f7f5ef;color:#1c352c;margin:0}header{background:#19382d;color:white;padding:20px}main{max-width:620px;margin:30px auto;padding:0 18px}.card{background:white;border:1px solid #d8ded7;border-radius:14px;padding:24px;box-shadow:0 4px 20px #0001}label{display:block;margin:18px 0 8px;font-weight:600}input[type=text]{box-sizing:border-box;width:100%;padding:14px;border:1px solid #9aaea3;border-radius:8px;font:inherit}button{background:#19382d;color:white;border:0;border-radius:8px;padding:13px 20px;font:inherit;cursor:pointer}button:disabled{opacity:.5;cursor:not-allowed}.note{color:#52645c;line-height:1.5}.status{white-space:pre-wrap;margin-top:18px;padding:12px;border-radius:8px;background:#eef2ef}.error{background:#ffe9e7;color:#8d2820}.success{background:#e2f3e8;color:#145c30}a{color:inherit}</style></head>
<body><header><strong>COURT 822 · OWNER TEAM CHECK-IN</strong></header><main><p><a href="owner.html">← Back to owner dashboard</a></p><div class="card"><h1>Check in a team</h1><p class="note">Enter the 64-character credential encoded in the team's official QR. This page does not support camera scanning yet. Verify both players' identities in person before submitting.</p><p id="session" class="status" role="status">Checking owner session…</p><form id="checkinForm"><label for="token">Team QR credential</label><input id="token" type="text" maxlength="64" minlength="64" autocomplete="off" spellcheck="false" placeholder="64-character hexadecimal credential" required><label><input id="identity" type="checkbox" required> I personally checked both players' identities.</label><p><button id="submit" type="submit" disabled>Confirm team check-in</button></p></form><div id="result" class="status" role="status" aria-live="polite">No check-in submitted.</div></div></main>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script><script src="config.js"></script><script src="supabase-client.js"></script><script>
'use strict';
const form=document.getElementById('checkinForm');const button=document.getElementById('submit');const session=document.getElementById('session');const result=document.getElementById('result');let allowed=false;let busy=false;
function show(message,type=''){result.className='status '+type;result.textContent=message;}
(async()=>{try{if(!window.courtDb)throw Error('Supabase is not configured.');const {data:{user},error}=await courtDb.auth.getUser();if(error||!user)throw Error('Sign in to the owner dashboard first.');const {data:profile,error:profileError}=await courtDb.from('profiles').select('role').eq('id',user.id).single();if(profileError||profile?.role!=='owner')throw Error('Owner access required.');allowed=true;button.disabled=false;session.textContent='Owner session verified.';}catch(e){session.textContent=e.message;}})();
form.addEventListener('submit',async e=>{e.preventDefault();if(!allowed||busy)return;const token=document.getElementById('token').value.trim().toLowerCase();if(!/^[0-9a-f]{64}$/.test(token)){show('Invalid QR credential. Expected 64 hexadecimal characters.','error');return;}if(!document.getElementById('identity').checked){show('Verify both player identities first.','error');return;}busy=true;button.disabled=true;show('Submitting check-in…');try{const {data,error}=await courtDb.rpc('court822_owner_checkin_team',{p_qr_token:token,p_identity_checked:true});if(error)throw Error(error.message);if(data?.success===true){show('CHECK-IN COMPLETE\nTeam ID: '+data.team_id+'\nCheckout ID: '+data.checkout_id,'success');form.reset();}else{show((data?.reason||'Check-in was not completed.')+(data?.checked_in_at?'\nPrevious check-in: '+data.checked_in_at:''),'error');}}catch(err){show('CHECK-IN FAILED\n'+err.message,'error');}finally{busy=false;button.disabled=!allowed;}});
</script></body></html>
